#!/usr/bin/env bash
# kodi-fleet — Kodi addon + handoff fleet rig (bin/check).
# Self-test gate (PASS / FAIL): compiles every Python module in the addons tree.
# NOTE: README references a `kodi-handoff` CLI deployed to /home/toxic/bin; that
# tool is NOT present in this repo (doc/code drift) — the repo's actual code is
# the addons. Live handoff deploy surface is external (see README).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== kodi-fleet check: start =="
pybin="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"

echo "-- addon python compile --"
fails=0
count=0
while IFS= read -r p; do
  [ -n "$p" ] || continue
  count=$((count+1))
  "$pybin" -m py_compile "$p" 2>/dev/null && echo "OK: $p" || { echo "FAIL: $p"; fails=$((fails+1)); }
done < <(find addons -name "*.py" 2>/dev/null)
[ "$count" -eq 0 ] && { echo "FAIL: no python modules found under addons/"; exit 1; }
[ "$fails" -eq 0 ] || { echo "FAIL: $fails module(s)"; exit 1; }
echo "OK: compiled $count addon python module(s)"

echo "-- handoff tool presence (doc/code drift check) --"
[ -x bin/kodi-handoff ] && echo "kodi-handoff: present" || echo "WARN: kodi-handoff NOT in repo (README references it; actual code is the addons)"

echo "== kodi-fleet check: PASS =="